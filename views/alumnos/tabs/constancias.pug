.tab-pane.fade#constancias-pane(role="tabpanel" aria-labelledby="constancias-tab")
  .card.mb-3.shadow-sm.border-0
    .card-body
      .d-flex.justify-content-between.align-items-center.mb-3
        h3.mb-0 Listado de solicitudes
        button.btn.btn-info.text-white.shadow-sm(data-bs-toggle="modal" data-bs-target="#modalConstancia")
          i.bi.bi-file-earmark-pdf.me-1
          | Nueva solicitud
      
      .table-responsive
        table.table.table-hover.align-middle.mb-0#tablaConstancias
          thead.table-dark
            tr
              th.ps-4 Constancia
              th Fecha solicitud
              th Presentar a
              th Estado
              th Fecha vencimiento
          tbody
            tr
              td.text-center.py-4.text-muted(colspan="5") Cargando solicitudes...

// Modal de Nueva Constancia
.modal.fade#modalConstancia(tabindex='-1')
  .modal-dialog
    .modal-content
      .modal-header.bg-info.text-white
        h5.modal-title Solicitar Constancia de Alumno Regular
        button.btn-close.btn-close-white(type='button' data-bs-dismiss='modal')
      form#formGenerarConstancia
        .modal-body
          .alert.alert-warning.small
            i.bi.bi-exclamation-triangle-fill.me-2
            | Por razones de seguridad, debes confirmar tu DNI para generar este documento oficial.
          .mb-3
            label.form-label Tu DNI (Sin puntos)
            input.form-control#inputDniConstancia(type='text' name='dni' required placeholder='Ej: 35123456')
          .mb-3
            label.form-label Presentar a:
            input.form-control(type='text' name='presentar_a' required placeholder='Ej: Obra Social, Empleador, etc.')
          .mb-3
            label.form-label Observaciones (Opcional):
            textarea.form-control(name='observaciones' rows="2" placeholder='Algún detalle adicional...')
        .modal-footer.bg-light
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancelar
          button.btn.btn-info.text-white(type='submit') 
            i.bi.bi-download.me-1
            | Generar y Descargar PDF

script.
  function getAuthHeadersLocal() {
    return { 'Content-Type': 'application/json' };
  }

  async function cargarConstancias() {
    const tbody = document.querySelector('#tablaConstancias tbody');
    try {
      const respuesta = await fetch('/api/constancias/mis-solicitudes', { headers: getAuthHeadersLocal() });
      const json = await respuesta.json();
      
      if (json.data && json.data.length > 0) {
        let html = '';
        json.data.forEach(c => {
          const fechaReq = new Date(c.fecha_emision).toLocaleDateString('es-AR');
          const fechaVenc = new Date(c.fecha_vencimiento).toLocaleDateString('es-AR');
          
          // Verificamos si la fecha actual superó la de vencimiento
          const vencida = new Date() > new Date(c.fecha_vencimiento);
          const badgeEstado = vencida 
              ? '<span class="badge bg-danger">Vencida</span>' 
              : '<span class="badge bg-success">Activa</span>';

          html += `
            <tr>
              <td class="ps-4 fw-medium text-primary">${c.tipo_constancia}</td>
              <td>${fechaReq}</td>
              <td>${c.presentar_a}</td>
              <td>${badgeEstado}</td>
              <td>${fechaVenc}</td>
            </tr>
          `;
        });
        tbody.innerHTML = html;
      } else {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No tienes solicitudes previas.</td></tr>';
      }
    } catch (error) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-danger">Error al cargar las solicitudes.</td></tr>';
    }
  }

  // Detectamos cuando se abre específicamente nuestra nueva pestaña
  document.addEventListener('shown.bs.tab', function (event) {
    if (event.target && event.target.getAttribute('data-bs-target') === '#constancias-pane') {
      cargarConstancias();
    }
  });

  // Manejador del formulario para generar y descargar el PDF
  document.getElementById('formGenerarConstancia')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const boton = e.target.querySelector('button[type="submit"]');
    const textoOriginal = boton.innerHTML;
    boton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generando...';
    boton.disabled = true;

    const data = Object.fromEntries(new FormData(e.target));
    
    try {
      const res = await fetch('/api/constancias/generar', {
        method: 'POST',
        headers: getAuthHeadersLocal(),
        body: JSON.stringify(data)
      });

      if (res.ok) {
        // Recibimos el PDF crudo en memoria (Blob) y forzamos la descarga nativa en el navegador
        const blob = await res.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Constancia_${data.dni}.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        
        bootstrap.Modal.getInstance(document.getElementById('modalConstancia')).hide();
        e.target.reset();
        cargarConstancias(); // Recargamos la tabla automáticamente
      } else {
        const err = await res.json();
        alert("Error de validación: " + err.error);
      }
    } catch (error) {
      console.error(error);
      alert("Error del Servidor. No se pudo conectar con el generador de PDF.");
    } finally {
      boton.innerHTML = textoOriginal;
      boton.disabled = false;
    }
  });