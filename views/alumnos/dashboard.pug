extends ../layout

block contenido
  .container.mt-4
    .row
      .col-12
        ul.nav.nav-tabs.nav-tabs-custom#dashboardTabs(role='tablist')
          li.nav-item
            button.nav-link.active(type='button' data-bs-toggle='tab' data-bs-target='#tabInscripciones' aria-controls='tabInscripciones' aria-selected='true') Inscripciones
          li.nav-item
            button.nav-link(type='button' data-bs-toggle='tab' data-bs-target='#tabHistorial' aria-controls='tabHistorial' aria-selected='false') Historial Académico

    .tab-content.mt-3
      .tab-pane.fade.show.active#tabInscripciones
        .row
          .col-md-4
            .card.mb-4
              .card-body
                h4= alumno.name
                p.mb-1.text-muted= `Legajo: ${alumno.legajo || 'N/A'}`
                p.mb-1.text-muted= `Cohorte: ${alumno.cohorte_id || 'Sin cohorte'}`
          .col-md-8
            h3 Materias disponibles
            if materias.length
              table.table.table-hover
                thead
                  tr
                    th Nombre
                    th Año
                    th Acciones
                tbody
                  each mat in materias
                    tr
                      td= mat.nombre
                      td= mat.anio
                      td
                        button.btn.btn-sm.btn-primary(type='button' data-materia=mat.id) Inscribirme
            else
              p.text-muted No hay materias cargadas.
      .tab-pane.fade#tabHistorial
        .row.mb-3
          .col-md-6
            .card.mb-3
              .card-body
                h5.card-title Datos del Alumno
                p.mb-1
                  strong Nombre:
                  span.ms-1= alumno.name
                p.mb-1
                  strong Legajo:
                  span.ms-1= alumno.legajo || 'N/A'
                p.mb-1
                  strong Cohorte:
                  span.ms-1= alumno.cohorte_id || 'Sin cohorte'
                p.mb-1
                  strong Email:
                  span.ms-1= alumno.email || 'No disponible'
          .col-md-6
            .card.mb-3
              .card-body
                h5.card-title Progreso de Carrera
                p.mb-1 Porcentaje completado:
                  strong#porcentajeCarrera Cargando...
                p.mb-1
                  small.text-muted Los datos se calculan desde tu historial académico.
        .card
          .card-body
            h5.card-title Historial Académico
            div#historialFeedback.mb-3
              p.text-muted Cargando historial...
            .table-responsive
              table.table.table-striped.table-hover#historialTable
                thead
                  tr
                    th Materia
                    th Año
                    th Condición
                    th Nota
                tbody
                  tr
                    td(colspan='4').text-center Cargando...

  // Modal de edición de perfil para Alumno
  .modal.fade#modalEditarAlumno(tabindex='-1')
    .modal-dialog.modal-lg
      .modal-content
        .modal-header.bg-primary.text-white
          h5.modal-title Editar Perfil
          button.btn-close.btn-close-white(type='button' data-bs-dismiss='modal')
        form#formEditarAlumno
          .modal-body
            .row
            .mb-3
              label.form-label Nombre Completo
              input.form-control#editAlumnoName(type='text' name='name' required)
            .row
              .col-6.mb-3
                label.form-label Email
                input.form-control#editAlumnoEmail(type='email' name='email' required)
              .col-6.mb-3
                label.form-label Nueva Contraseña
                input.form-control#editAlumnoPassword(type='password' name='password')
              .col-6.mb-3
                label.form-label Fecha de Inscripción
                input.form-control#editAlumnoFecha(type='date' name='fecha_inscripcion' readonly)
          .modal-footer.bg-light
            button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancelar
            button.btn.btn-primary(type='submit') Guardar Cambios

  .modal.fade#modalMensaje(tabindex='-1' aria-hidden='true')
    .modal-dialog
      .modal-content
        .modal-header.bg-info.text-white
          h5.modal-title#modalMensajeTitulo Mensaje
          button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          p#modalMensajeTexto.mb-0
        .modal-footer.bg-light
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cerrar

  // Globo flotante para abrir el chat
  button.btn.btn-primary.rounded-circle.shadow-lg#btn-chat-flotante(type='button' style='position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 1050;' onclick='toggleChat()')
    i.bi.bi-chat-dots-fill.fs-3

  .card.shadow-lg#ventana-chat-flotante(style='position: fixed; bottom: 100px; right: 30px; width: 350px; display: none; z-index: 1050; border-radius: 15px; overflow: hidden;')
    .card-header.bg-primary.text-white.d-flex.justify-content-between.align-items-center
      h6.mb-0
        i.bi.bi-robot.me-2
        | Soporte IA
      button.btn-close.btn-close-white.btn-sm(type='button' onclick='toggleChat()')
    .card-body.bg-light.p-3
      ul#chat-messages.list-unstyled(style='height: 300px; overflow-y: auto; margin-bottom: 0;')
        li.mb-3
          .bg-white.border.border-primary.rounded.p-2.shadow-sm(style='max-width: 85%;')
            small.fw-bold.text-primary Asistente:
            br
            small ¡Hola! Soy tu asistente de soporte. Escribí tu duda y con gusto te ayudaremos.
    .card-footer.bg-white.p-2
      form#chat-form.d-flex
        input#chat-input.form-control.form-control-sm.me-2(type='text' placeholder='Escribí acá...' autocomplete='off' required)
        button.btn.btn-sm.btn-primary(type='submit')
          i.bi.bi-send-fill

block scripts
  script(src='/socket.io/socket.io.js')
  script.
    function toggleChat() {
      const ventana = document.getElementById('ventana-chat-flotante');
      ventana.style.display = ventana.style.display === 'none' ? 'block' : 'none';
    }

    function mostrarModalMensaje(titulo, mensaje) {
      const modalTitulo = document.getElementById('modalMensajeTitulo');
      const modalTexto = document.getElementById('modalMensajeTexto');
      const modalElement = document.getElementById('modalMensaje');
      if (modalTitulo) modalTitulo.innerText = titulo;
      if (modalTexto) modalTexto.innerText = mensaje;
      if (modalElement) new bootstrap.Modal(modalElement).show();
    }

    // Función auxiliar para obtener las cabeceras
    // El JWT se envía automáticamente en las cookies (httpOnly)
    // Solo necesitamos content-type en la mayoría de casos
    function getAuthHeaders() {
      return { 'Content-Type': 'application/json' };
    }

    async function cargarHistorialAcademico() {
      const alumnoId = #{alumno.id};
      const feedback = document.getElementById('historialFeedback');
      const porcentaje = document.getElementById('porcentajeCarrera');
      const tabla = document.getElementById('historialTable');

      if (!tabla || !porcentaje || !feedback) return;

      try {
        const respuesta = await fetch(`/api/estado-academico/${alumnoId}`, {
          headers: getAuthHeaders()
        });
        if (!respuesta.ok) {
          throw new Error('No se pudo cargar el historial académico');
        }
        const data = await respuesta.json();
        porcentaje.innerText = data.porcentaje_carrera || '0%';

        if (!data.materias || !data.materias.length) {
          tabla.querySelector('tbody').innerHTML = '<tr><td colspan="4" class="text-center text-muted">No hay materias en el historial.</td></tr>';
          feedback.innerHTML = '<p class="text-muted">No se encontraron materias en el historial académico.</p>';
          return;
        }

        const filas = data.materias.map(m => {
          const nota = m.nota !== null && m.nota !== undefined ? m.nota : '-';
          return `
            <tr>
              <td>${m.nombre}</td>
              <td>${m.anio || '-'}</td>
              <td>${m.estado || '-'}</td>
              <td>${nota}</td>
            </tr>
          `;
        }).join('');

        tabla.querySelector('tbody').innerHTML = filas;
        feedback.innerHTML = '<p class="text-muted">Se muestran todas las materias del plan ordenadas por año.</p>';
      } catch (error) {
        tabla.querySelector('tbody').innerHTML = '<tr><td colspan="4" class="text-center text-danger">Error cargando el historial.</td></tr>';
        feedback.innerHTML = `<p class="text-danger">${error.message}</p>`;
      }
    }

    document.addEventListener('click', async (e) => {
      if (e.target && e.target.dataset && e.target.dataset.materia) {
        const materiaId = e.target.dataset.materia;
        const alumnoId = #{alumno.id};
        const cohorteId = #{alumno.cohorte_id || 'null'};

        try {
          const resp = await fetch('/api/inscripciones', {
            method: 'POST',
            headers: getAuthHeaders(),
            body: JSON.stringify({ alumno_id: alumnoId, cohorte_id: cohorteId, materia_id: parseInt(materiaId) })
          });
          const json = await resp.json();
          if (!resp.ok) throw new Error(json.error || json.message || 'Error');
          mostrarModalMensaje('Inscripción exitosa', 'Se completó la inscripción correctamente.');
          setTimeout(() => location.reload(), 1200);
        } catch (err) {
          mostrarModalMensaje('Error de correlatividad', err.message || 'Ocurrió un error.');
        }
      }
    });

    document.addEventListener('shown.bs.tab', function (event) {
      if (event.target && event.target.getAttribute('data-bs-target') === '#tabHistorial') {
        cargarHistorialAcademico();
      }
    });

    const socket = io();
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');

    function agregarMensajeVisual(emisor, texto, clasesCaja, clasesTitulo) {
      const li = document.createElement('li');
      li.classList.add('mb-3', 'd-flex');
      li.innerHTML = `
        <div class="${clasesCaja} rounded p-2 shadow-sm" style="max-width: 85%;">
          <small class="fw-bold ${clasesTitulo}">${emisor}</small><br>
          <small>${texto}</small>
        </div>
      `;
      chatMessages.appendChild(li);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    if (chatForm) {
      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const texto = chatInput.value.trim();
        if (!texto) return;

        agregarMensajeVisual('Vos', texto, 'bg-primary text-white ms-auto', 'text-white-50');

        socket.emit('mensaje', {
          usuario: currentUser?.name || 'Alumno',
          texto,
          usuarioLogueado: currentUser || null
        });
        chatInput.value = '';
      });
    }

    socket.on('mensaje', (datos) => {
      const nombreUsuario = currentUser?.name || 'Alumno';
      if (datos.usuario !== nombreUsuario) {
        const esIA = datos.usuario === 'Asesor Virtual';
        const clasesCaja = esIA ? 'bg-white border border-primary' : 'bg-secondary text-white';
        const clasesTitulo = esIA ? 'text-primary' : 'text-white-50';
        agregarMensajeVisual(datos.usuario, datos.texto, clasesCaja, clasesTitulo);
      }
    });

    document.addEventListener('DOMContentLoaded', function () {
      const historialTab = document.querySelector('[data-bs-target="#tabHistorial"]');
      if (historialTab && historialTab.classList.contains('active')) {
        cargarHistorialAcademico();
      }
    });
