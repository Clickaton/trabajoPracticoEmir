script.
  let alumnosActuales = [];

  function abrirModalEditar(admin) {
    document.getElementById('editName').value = admin.name;
    document.getElementById('editEmail').value = admin.email;
    document.getElementById('editArea').value = admin.area;
    document.getElementById('editRol').value = admin.rol;
    document.getElementById('formEditar').action = `/api/administrativos/editar/${admin.id}`;
    new bootstrap.Modal(document.getElementById('modalEditar')).show();
  }
  
  document.addEventListener("DOMContentLoaded", async function() {
    // Se recuerda la última pestaña abierta. El almacenamiento del navegador puede no estar disponible (ventana privada,
    // sitios bloqueados): en ese caso simplemente no se recuerda y el panel abre en la primera pestaña.
    let activeTab = null;
    try { activeTab = localStorage.getItem('activeTab'); } catch (_) { /* sin almacenamiento: no pasa nada */ }
    if (activeTab) {
      // Solo se acepta un selector de id (#algo): lo guardado nunca se usa tal cual dentro de un selector
      const tabElement = /^[#][\w-]+$/.test(activeTab) ? document.querySelector(`button[data-bs-target="${activeTab}"]`) : null;
      if (tabElement) new bootstrap.Tab(tabElement).show();
    }
    document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(button => {
      button.addEventListener('shown.bs.tab', e => {
        try { localStorage.setItem('activeTab', e.target.getAttribute('data-bs-target')); } catch (_) { /* opcional */ }
      });
    });
    // Los planes se cargan primero: las cohortes y las materias dependen de ellos
    await cargarPlanes();
    cargarCohortes();
    cargarMaterias();
    cargarPeriodos();
  });
