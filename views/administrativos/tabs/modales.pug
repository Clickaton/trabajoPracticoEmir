.modal.fade#modalInscribirFinal(tabindex="-1")
  .modal-dialog.modal-dialog-scrollable
    .modal-content
      .modal-header.bg-danger.text-white
        h5.modal-title Inscribir a un final
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formInscribirFinal
        .modal-body
          #inscFinalDescripcion.alert.alert-light.border.small.py-2
          .mb-3
            label.form-label.fw-bold(for="inscFinalPeriodo") Mesa (período de Final)
              +ayuda('Podés elegir también un período cerrado o fuera de fecha: queda registrado como inscripción por excepción. Las reglas académicas (regularidad vigente, llamados, ausentes y correlatividades con final aprobado) se controlan igual que para el alumno.')
            select.form-select#inscFinalPeriodo(required)
              option(value="" disabled selected) Cargando períodos...
            #avisoInscFinalPeriodo.small.mt-2
          .mb-0
            label.form-label.fw-bold Materias
              +ayuda('Solo se ofrecen las materias que el alumno tiene Regulares. Las que hoy no puede rendir figuran deshabilitadas con el motivo.')
            #inscFinalMaterias.border.rounded.p-2.bg-white(style="max-height: 300px; overflow-y: auto;")
              .text-muted.small Cargando materias...
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-danger#btnConfirmarInscFinal(type="submit" data-ayuda="Inscribir al alumno en las materias tildadas de esta mesa") Inscribir

.modal.fade#modalMesaFinal(tabindex="-1")
  .modal-dialog.modal-xl.modal-dialog-scrollable
    .modal-content
      .modal-header.bg-dark.text-white
        div
          h5.modal-title.mb-0#tituloMesaFinal Mesa de examen
          small.text-white-50#subtituloMesaFinal
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      .modal-body.bg-light
        .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
          #resumenMesaFinal.small
          .d-flex.align-items-center.gap-2
            label.form-label.small.mb-0(for="filtroMateriaMesa") Materia
            select.form-select.form-select-sm.w-auto#filtroMateriaMesa
              option(value="") Todas
            +ayuda('Lista de los alumnos inscriptos a cada materia en este llamado. Cargá el resultado de cada uno; también se puede corregir uno ya cargado. Un Desaprobado o un Ausente consumen un llamado de la regularidad del alumno.')
        #contenedorMesaFinal
          .p-4.text-center.text-muted Cargando mesa...
      .modal-footer
        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cerrar

.modal.fade#modalResultadoFinal(tabindex="-1" data-bs-backdrop="static")
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header.bg-danger.text-white
        h6.modal-title Resultado del final
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formResultadoFinal
        .modal-body
          input(type="hidden" id="resFinalId")
          #resFinalDescripcion.alert.alert-light.border.small.py-2
          .mb-3
            label.form-label.small.fw-bold(for="resFinalResultado") Resultado
              +ayuda('Aprobado: la materia pasa a Aprobada (nota 4 o más, con libro y folio). Desaprobado: consume un llamado. Ausente: no se presentó; consume un llamado y suma una ausencia.')
            select.form-select.form-select-sm#resFinalResultado(name="resultado" required)
              option(value="Aprobado") Aprobado
              option(value="Desaprobado") Desaprobado
              option(value="Ausente") Ausente
          .row
            .col-4.mb-3#grupoResFinalNota
              label.form-label.small.fw-bold(for="resFinalNota") Nota
                +ayuda('Entero de 1 a 10. Aprobado: 4 o más. Desaprobado: de 1 a 3 (opcional). Un ausente no lleva nota.')
              input.form-control.form-control-sm#resFinalNota(type="number" name="nota" min="1" max="10" step="1")
            .col-4.mb-3
              label.form-label.small.fw-bold(for="resFinalLibro") Libro
                +ayuda('Libro de actas del examen. Obligatorio cuando hay nota.')
              input.form-control.form-control-sm#resFinalLibro(type="text" name="libro" maxlength="30")
            .col-4.mb-3
              label.form-label.small.fw-bold(for="resFinalFolio") Folio
                +ayuda('Folio del libro de actas. Obligatorio cuando hay nota.')
              input.form-control.form-control-sm#resFinalFolio(type="text" name="folio" maxlength="30")
          .mb-3
            label.form-label.small.fw-bold(for="resFinalFecha") Fecha del examen
              +ayuda('Día en que se rindió. Si la dejás vacía se usa la de la mesa.')
