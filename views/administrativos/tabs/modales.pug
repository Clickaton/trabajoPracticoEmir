// ==========================================
// MODALES DE PERÍODOS DE INSCRIPCIÓN
// ==========================================
.modal.fade#modalCrearPeriodo(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-primary.text-white
        h5.modal-title Nuevo Período de Inscripción
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formCrearPeriodo
        .modal-body
          .mb-3
            label.form-label(for="crearPeriodoNombre") Nombre del Llamado
              +ayuda('Nombre con el que se identifica el período. Ej: Mesa de Diciembre 2026.')
            input.form-control#crearPeriodoNombre(type="text" name="nombre" required placeholder="Ej: Mesa de Diciembre 2026")
          .mb-3
            label.form-label(for="crearPeriodoTipo") Tipo de período
              +ayuda('Cursada: los alumnos se anotan a materias. Final: los alumnos se anotan a mesas de examen. Un período de Final cuenta como un llamado transcurrido para el vencimiento de la regularidad.')
            select.form-select#crearPeriodoTipo(name="tipo" required)
              option(value="Cursada" selected) Cursada (inscripción a materias)
              option(value="Final") Final (inscripción a mesas de examen)
          #grupoFechaExamenCrear.mb-3.d-none
            label.form-label(for="crearPeriodoFechaExamen") Fecha de examen
              +ayuda('Día en que se toma la mesa. Es informativa y se muestra a los alumnos; la inscripción se controla con las fechas de apertura y cierre.')
            input.form-control#crearPeriodoFechaExamen(type="date" name="fechaExamen")
          .row
            .col-6.mb-3
              label.form-label(for="crearPeriodoFechaInicio") Fecha Inicio
                +ayuda('Primer día en que los alumnos pueden inscribirse.')
              input.form-control#crearPeriodoFechaInicio(type="date" name="fechaInicio" required)
            .col-6.mb-3
              label.form-label(for="crearPeriodoHoraInicio") Hora Inicio
                +ayuda('Hora del primer día a partir de la cual se abre la inscripción.')
              input.form-control#crearPeriodoHoraInicio(type="time" name="horaInicio" required)
          .row
            .col-6.mb-3
              label.form-label(for="crearPeriodoFechaFin") Fecha Fin
                +ayuda('Último día de inscripción. Después de esa fecha y hora el período se cierra solo.')
              input.form-control#crearPeriodoFechaFin(type="date" name="fechaFin" required)
            .col-6.mb-3
              label.form-label(for="crearPeriodoHoraFin") Hora Fin
                +ayuda('Hora del último día en la que se cierra la inscripción.')
              input.form-control#crearPeriodoHoraFin(type="time" name="horaFin" required)
          .form-check.form-switch
            input.form-check-input#crearPeriodoActivo(type="checkbox" name="activo" role="switch")
            label.form-check-label(for="crearPeriodoActivo") Abrir la inscripción ahora
              +ayuda('Si no lo tildás, el período se crea cerrado y lo abrís después desde la lista. Para que los alumnos se inscriban tiene que estar abierto Y dentro de sus fechas.')
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-primary(type="submit" data-ayuda="Crear el período con estas fechas") Guardar Período

.modal.fade#modalEditarPeriodo(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-warning.text-dark
        h5.modal-title Editar Período
        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formEditarPeriodo
        .modal-body
          input(type="hidden" id="editPeriodoId" name="id")
