.modal.fade#modalCrear(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-info.text-white
        h5.modal-title Nuevo Administrativo
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")
      form(action="/api/administrativos" method="POST")
        .modal-body
          .mb-3
            label.form-label Nombre
              +ayuda('Nombre y apellido de la persona que va a usar el panel.')
            input.form-control(type="text" name="name" required)
          .mb-3
            label.form-label Email
              +ayuda('Correo con el que la persona ingresa al sistema.')
            input.form-control(type="email" name="email" required)
          .mb-3
            label.form-label Contraseña
              +ayuda('Contraseña inicial de acceso. Después la persona puede cambiarla desde Mi Perfil.')
            input.form-control(type="password" name="password" required)
          .row
            .col-6.mb-3
              label.form-label Área
                +ayuda('Sector del instituto en el que trabaja la persona.')
              select.form-select(name="area" required)
                option(value="Alumnos") Alumnos
                option(value="Sistemas") Sistemas
            .col-6.mb-3
              label.form-label Rol
                +ayuda('Define qué puede hacer la persona dentro del panel.')
              select.form-select(name="rol" required)
                option(value="" selected disabled) Seleccione un rol...
                if roles
                  each rol in roles
                    option(value=rol)= rol
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-info.text-white(type="submit" data-ayuda="Dar de alta a la persona con los datos ingresados") Guardar

.modal.fade#modalEditar(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-primary.text-white
        h5.modal-title Editar Administrativo
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")
      form#formEditar(method="POST")
        .modal-body
          .mb-3
            label.form-label Nombre
              +ayuda('Nombre y apellido de la persona que va a usar el panel.')
            input.form-control#editName(type="text" name="name" required)
          .mb-3
            label.form-label Email
              +ayuda('Correo con el que la persona ingresa al sistema.')
            input.form-control#editEmail(type="email" name="email" required)
          .row
            .col-6.mb-3
              label.form-label Área
                +ayuda('Sector del instituto en el que trabaja la persona.')
              select.form-select#editArea(name="area" required)
                option(value="Alumnos") Alumnos
                option(value="Sistemas") Sistemas
            .col-6.mb-3
              label.form-label Rol
                +ayuda('Define qué puede hacer la persona dentro del panel.')
              select.form-select#editRol(name="rol" required)
                option(value="" disabled) Seleccione un rol...
                if roles
                  each rol in roles
                    option(value=rol)= rol
            .col-6.mb-3
              label.form-label Nueva Contraseña (Opcional)
                +ayuda('Completala solo si querés cambiarla; si la dejás vacía se mantiene la actual.')
              input.form-control#editPassword(type="password" name="password" placeholder="Dejar en blanco para no cambiar")
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-primary(type="submit" data-ayuda="Guardar los cambios de esta persona") Actualizar Cambios

.modal.fade#modalCrearCohorte(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-primary.text-white
        h5.modal-title Nueva Cohorte
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formCrearCohorte
        .modal-body
          .mb-3
            label.form-label(for="crearCohorteNombre") Nombre / Año
              +ayuda('Cómo se identifica la cohorte, normalmente por el año de ingreso. Ej: 2026.')
            input.form-control#crearCohorteNombre(type="text" name="name" required placeholder="Ej: 2026")
          .mb-3
            label.form-label(for="crearCohorteInicio") Fecha de Inicio
              +ayuda('Día en que empieza a cursar la cohorte. Sirve de referencia para el inicio del ciclo.')
            input.form-control#crearCohorteInicio(type="date" name="startDate" required)
          .mb-3
            label.form-label(for="selectPlanCohorte") Plan de estudios
              +ayuda('Carrera que cursa la cohorte. Define qué materias ve, sus correlatividades y las reglas de regularidad. Solo aparecen los planes activos. Si falta el plan, crealo en "Planes de Estudio".')
            select.form-select#selectPlanCohorte(name="plan_id" required)
              option(value="" selected disabled) Cargando planes...
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-primary(type="submit" data-ayuda="Crear la cohorte con el plan elegido") Guardar Cohorte

.modal.fade#modalCrearAlumno(tabindex="-1")
  .modal-dialog.modal-lg.modal-dialog-scrollable
    .modal-content
      .modal-header.bg-info.text-white
        h5.modal-title Dar de Alta Nuevo Alumno
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formCrearAlumno
        .modal-body
          .alert.alert-info.py-2.mb-4(role="alert")
            i.bi.bi-info-circle-fill.me-2
            span#textoAvisoCohorte El alumno será inscripto en la cohorte seleccionada.
          .row
            .col-6.mb-3
              label.form-label(for="crearAlumnoDni") DNI
                +ayuda('Documento del alumno, sin puntos. No puede repetirse con otro alumno.')
              input.form-control#crearAlumnoDni(type="text" name="dni" required)
            .col-6.mb-3
              label.form-label(for="crearAlumnoLegajo") Legajo
                +ayuda('Número de legajo institucional. No puede repetirse.')
              input.form-control#crearAlumnoLegajo(type="text" name="legajo" required)
          .mb-3
            label.form-label(for="crearAlumnoNombre") Nombre Completo
              +ayuda('Apellido y nombre del alumno tal como figura en su DNI.')
            input.form-control#crearAlumnoNombre(type="text" name="name" required)
          .row
            .col-6.mb-3
              label.form-label(for="crearAlumnoEmail") Email
                +ayuda('Correo de contacto del alumno.')
              input.form-control#crearAlumnoEmail(type="email" name="email" required)
            .col-6.mb-3
              label.form-label(for="crearAlumnoPassword") Contraseña
                +ayuda('Contraseña inicial para que el alumno ingrese al sistema.')
              input.form-control#crearAlumnoPassword(type="password" name="password" required autocomplete="new-password")
          .row
            .col-6.mb-3
              label.form-label(for="crearAlumnoActivo") Estado
                +ayuda('Un alumno inactivo no debería cursar. Se puede cambiar después.')
              select.form-select#crearAlumnoActivo(name="activo" required)
                option(value="true") Activo
                option(value="false") Inactivo
            .col-6.mb-3
              label.form-label(for="crearAlumnoFecha") Fecha de Inscripción
                +ayuda('Día en que el alumno se inscribió al instituto.')
              input.form-control#crearAlumnoFecha(type="date" name="fecha_inscripcion" required)
          +camposIngreso('crearAlumno')
          input(type="hidden" name="cohorte_id" id="hiddenCohorteId" value="")
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-info.text-white(type="submit" data-ayuda="Dar de alta al alumno e inscribirlo en la cohorte seleccionada") Crear e Inscribir

//- Los ids terminan en "Adm" a propósito: layout.pug engancha un manejador a #formEditarAlumno / #modalEditarAlumno (el perfil del propio alumno).
//- Con los mismos ids, editar un alumno desde este panel disparaba además ese manejador (un segundo PUT y una recarga de la página).
.modal.fade#modalEditarAlumnoAdm(tabindex="-1")
  .modal-dialog.modal-lg.modal-dialog-scrollable
    .modal-content
      .modal-header.bg-primary.text-white
        h5.modal-title Editar Ficha del Alumno
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formEditarAlumnoAdm
        .modal-body
          .row
            .col-4.mb-3
              label.form-label(for="editAlumnoId") ID
                +ayuda('Número interno del alumno. No se puede modificar.')
              input.form-control#editAlumnoId(type="number" name="id" readonly)
            .col-4.mb-3
              label.form-label(for="editAlumnoDni") DNI
                +ayuda('Documento del alumno, sin puntos. No puede repetirse con otro alumno.')
              input.form-control#editAlumnoDni(type="text" name="dni" required)
            .col-4.mb-3
              label.form-label(for="editAlumnoLegajo") Legajo
                +ayuda('Número de legajo institucional. No puede repetirse.')
              input.form-control#editAlumnoLegajo(type="text" name="legajo" required)
          .mb-3
            label.form-label(for="editAlumnoName") Nombre Completo
              +ayuda('Apellido y nombre del alumno tal como figura en su DNI.')
            input.form-control#editAlumnoName(type="text" name="name" required)
          .row
            .col-6.mb-3
              label.form-label(for="editAlumnoEmail") Email
                +ayuda('Correo de contacto del alumno.')
              input.form-control#editAlumnoEmail(type="email" name="email" required)
            .col-6.mb-3
              label.form-label(for="editAlumnoPassword") Contraseña (dejar en blanco para no cambiar)
                +ayuda('Completala solo si querés cambiar la contraseña del alumno; si la dejás vacía se mantiene la actual.')
              input.form-control#editAlumnoPassword(type="password" name="password" autocomplete="new-password")
          .row
            .col-6.mb-3
              label.form-label(for="editAlumnoActivo") Estado
                +ayuda('Un alumno inactivo no debería cursar. Se puede volver a activar en cualquier momento.')
              select.form-select#editAlumnoActivo(name="activo" required)
                option(value="true") Activo
                option(value="false") Inactivo
            .col-6.mb-3
              label.form-label(for="editAlumnoFecha") Fecha de Inscripción
                +ayuda('Día en que el alumno se inscribió al instituto.')
              input.form-control#editAlumnoFecha(type="date" name="fecha_inscripcion" required)
          +camposIngreso('editAlumno')
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-primary(type="submit" data-ayuda="Guardar los cambios de la ficha del alumno") Guardar Cambios

.modal.fade#modalCrearMateria(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-primary.text-white
        h5.modal-title Nueva Materia
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formCrearMateria
        .modal-body
          .mb-3
            label.form-label(for="selectPlanMateria") Plan de estudios
              +ayuda('Plan al que pertenece la materia. Una vez creada no se puede pasar a otro plan.')
            select.form-select#selectPlanMateria(name="plan_id" required)
          .row
            .col-6.mb-3
              label.form-label(for="crearMateriaAnio") Año de Cursada
                +ayuda('Año de la carrera en que se cursa (1, 2, 3...). Las listas se ordenan por año y luego por nombre.')
              input.form-control#crearMateriaAnio(type="number" name="anio" required min="1" max="10" placeholder="Ej: 1")
            .col-6.mb-3
              label.form-label(for="crearMateriaId") ID de Materia (opcional)
                +ayuda('Dejalo vacío y el sistema asigna el siguiente número libre. Completalo solo si necesitás un número puntual.')
              input.form-control#crearMateriaId(type="number" name="id" min="1" placeholder="Automático")
          .mb-3
            label.form-label(for="crearMateriaNombre") Nombre de la Materia
              +ayuda('Nombre de la materia como figura en el plan de estudios.')
            input.form-control#crearMateriaNombre(type="text" name="nombre" required placeholder="Ej: Programación I")
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-primary(type="submit" data-ayuda="Agregar la materia al plan") Guardar Materia

.modal.fade#modalEditarMateria(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-warning.text-dark
        h5.modal-title Editar Materia
        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formEditarMateria
        .modal-body
          .mb-3
            label.form-label(for="editMateriaPlan") Plan de estudios
              +ayuda('El plan de una materia no se puede cambiar, porque el historial y las correlatividades ya dependen de él. Si se cargó en el plan equivocado, creala de nuevo en el correcto.')
            input.form-control#editMateriaPlan(type="text" disabled)
          .row
            .col-6.mb-3
              label.form-label(for="editMateriaId") ID (no modificable)
                +ayuda('Identificador interno de la materia. No se puede modificar.')
              input.form-control#editMateriaId(type="number" name="id" readonly)
            .col-6.mb-3
              label.form-label(for="editMateriaAnio") Año de Cursada
                +ayuda('Año de la carrera en que se cursa. Las listas se ordenan por año y luego por nombre.')
              input.form-control#editMateriaAnio(type="number" name="anio" required min="1" max="10")
          .mb-3
            label.form-label(for="editMateriaNombre") Nombre de la Materia
              +ayuda('Nombre de la materia como figura en el plan de estudios.')
            input.form-control#editMateriaNombre(type="text" name="nombre" required)
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-warning(type="submit" data-ayuda="Guardar los cambios de la materia") Guardar Cambios

.modal.fade#modalCrearRegla(tabindex="-1")
  .modal-dialog
    .modal-content
      .modal-header.bg-info.text-white
        h5.modal-title Agregar Requisito
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formCrearRegla
        .modal-body
          .alert.alert-info.py-2.mb-3
            span#textoAvisoMateriaRegla Agregando requisito para...
          input(type="hidden" name="materia_id" id="hiddenMateriaParaRegla")
          .mb-3
            label.form-label(for="selectMateriaRequisito") Materia Requisito
              +ayuda('Materia que el alumno debe tener antes de cursar esta. Solo se ofrecen materias del mismo plan.')
            select.form-select#selectMateriaRequisito(name="requisito_id" required)
              option(value="" selected disabled) Cargando materias...
          .mb-3
            label.form-label(for="selectTipoRequisito") Condición exigida
              +ayuda('Regular: alcanza con haber regularizado la cursada. Aprobada: hace falta tener el final aprobado. Esto rige para CURSAR; para rendir el FINAL de la materia siempre se pide el final aprobado de sus correlativas.')
            select.form-select#selectTipoRequisito(name="tipo_requisito" required)
              option(value="Regular") Tenerla Regular
              option(value="Aprobada") Tenerla Aprobada (Final)
        .modal-footer.bg-light
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-info.text-white(type="submit" data-ayuda="Guardar la correlatividad") Guardar Regla

.modal.fade#modalFichaAlumno(tabindex="-1")
  .modal-dialog.modal-xl.modal-dialog-scrollable
    .modal-content
      .modal-header.bg-dark.text-white
        div
          h5.modal-title.mb-0#tituloFichaAlumno Ficha Académica
          small.text-white-50#subtituloFichaAlumno
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      .modal-body.bg-light
        .row.g-3.mb-3
          .col-md-4
            .card.shadow-sm.border-0.h-100
              .card-body
                h6.text-secondary.mb-2 Semáforo
                  +ayuda('Verde: al día. Amarillo: promoción condicional (aprobó la cursada pero debe el final de una correlativa). Rojo: perdió la regularidad de alguna materia y debe volver a cursarla. El color del alumno es el peor de sus materias.')
                #fichaSemaforo.mb-2
                small.text-muted#fichaSemaforoConteo
          .col-md-4
            .card.shadow-sm.border-0.h-100
              .card-body
                h6.text-secondary.mb-2 Progreso de la Carrera
                  +ayuda('Cuenta las materias aprobadas y las promocionadas que ya no deben ningún final de sus correlativas.')
                .progress(style="height: 25px;")
                  .progress-bar.bg-success.fw-bold#barraProgresoCarrera(role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100") 0%
                small.text-muted#fichaProgresoTexto
          .col-md-4
            .card.shadow-sm.border-0.h-100
              .card-body
                h6.text-secondary.mb-2 Plan e ingreso
                #fichaPlanIngreso.small
        #alertasFichaAlumno.mb-3
        .card.shadow-sm.border-0.mb-4
          .card-header.bg-white
            h6.mb-0.text-info
              i.bi.bi-list-check.me-2
              | Estado por Materia
              +ayuda('Todas las materias del plan, por año. La regularidad muestra cuándo vence y cuántos llamados y ausentes le quedan. Si perdió la regularidad, la materia figura como Vencida y puede volver a cursarla.')
          .card-body.p-0#contenedorFichaEstado
            .p-4.text-center.text-muted Cargando estado académico...
        .row
          .col-lg-6
            .card.shadow-sm.border-0.mb-4
              .card-header.bg-white
                h6.mb-0.text-primary
                  i.bi.bi-calendar-check.me-2
                  | Cursadas Actuales (Inscripciones)
                  +ayuda('Materias en las que el alumno está inscripto para cursar y todavía no tienen acta de regularidad.')
              .card-body.p-0#contenedorFichaInscripciones
                .p-4.text-center.text-muted Cargando inscripciones...
          .col-lg-6
            .card.shadow-sm.border-0.mb-4
              .card-header.bg-white.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
                h6.mb-0.text-danger
                  i.bi.bi-pencil-square.me-2
                  | Finales (Inscripciones y Resultados)
                  +ayuda('Inscripciones del alumno a mesas de examen. Desde acá se carga o corrige el resultado (nota, libro y folio) o se anula una inscripción pendiente.')
                button.btn.btn-sm.btn-outline-danger#btnInscribirFinal(type="button" onclick="abrirModalInscripcionFinal()")
                  i.bi.bi-plus-circle.me-1
                  | Inscribir a un final
              .card-body.p-0#contenedorFichaFinales
                .p-4.text-center.text-muted Cargando finales...
        .card.shadow-sm.border-0.mb-2
          .card-header.bg-white.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
            h6.mb-0.text-secondary
              i.bi.bi-archive.me-2
              | Historial Académico (Actas y Notas)
              +ayuda('Registro de cada cursada y final, con su acta (libro y folio). Si el alumno volvió a cursar una materia, los intentos anteriores se conservan acá como historia. Usá "Cargar registro" para ingresar historial anterior (pase, ingreso a 2do o 3er año).')
            button.btn.btn-sm.btn-success#btnNuevoRegistro(type="button" onclick="abrirModalNuevoRegistro()")
              i.bi.bi-plus-circle.me-1
              | Cargar registro
          .card-body.p-0#contenedorFichaHistorial
            .p-4.text-center.text-muted Cargando historial...
      .modal-footer
        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cerrar Expediente

.modal.fade#modalEditarActa(tabindex="-1" data-bs-backdrop="static")
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header.bg-success.text-white
        h6.modal-title#tituloActa Registrar Acta / Nota
        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
      form#formEditarActa
        .modal-body
          input(type="hidden" id="editActaRegistroId")
          input(type="hidden" id="editActaAlumnoId")
          .mb-3
            label.form-label.small.fw-bold(for="editActaMateria") Materia
              +ayuda('Materia del plan del alumno. Si ya la tiene Regular o en otro estado vigente, modificá ese registro en lugar de crear otro. Solo se abre una nueva cursada (recursada) si la anterior quedó Vencida.')
            select.form-select.form-select-sm#editActaMateria(name="materia_id")
            input.form-control.form-control-sm.d-none#editActaMateriaTexto(type="text" disabled)
          .mb-3
            label.form-label.small.fw-bold(for="editActaEstado") Estado
              +ayuda('Cursando: está cursando. Regular: aprobó la cursada y puede rendir el final. Promocionada: aprobó sin final (nota 4 o más). Aprobada: tiene el final aprobado. Vencida: perdió la regularidad.')
            select.form-select.form-select-sm#editActaEstado(name="estado" required)
              option(value="Cursando") Cursando
              option(value="Regular") Regular
              option(value="Promocionada") Promocionada
              option(value="Aprobada") Aprobada (final aprobado)
              option(value="Vencida") Vencida (perdió la regularidad)
          .mb-3#grupoActaFechaReg
            label.form-label.small.fw-bold(for="editActaFechaReg") Fecha de regularización
              +ayuda('Desde esta fecha se cuentan el plazo de vigencia y los llamados de la regularidad. Para historial viejo cargá la fecha real, no la de hoy. No puede ser futura.')
            input.form-control.form-control-sm#editActaFechaReg(type="date" name="fechaRegularizacion")
          .row#filaActaNota
            .col-4.mb-3#grupoActaNota
              label.form-label.small.fw-bold(for="editActaNota") Nota
                +ayuda('Número entero de 1 a 10. Para Aprobada y Promocionada, 4 o más.')
              input.form-control.form-control-sm#editActaNota(type="number" name="nota" min="1" max="10" step="1" placeholder="1 a 10")
            .col-4.mb-3#grupoActaLibro
              label.form-label.small.fw-bold(for="editActaLibro") Libro
                +ayuda('Libro de actas donde consta la nota. Obligatorio cuando se carga una nota.')
              input.form-control.form-control-sm#editActaLibro(type="text" name="libro" maxlength="30" placeholder="Ej: 12")
            .col-4.mb-3#grupoActaFolio
              label.form-label.small.fw-bold(for="editActaFolio") Folio
                +ayuda('Folio del libro de actas. Obligatorio cuando se carga una nota.')
              input.form-control.form-control-sm#editActaFolio(type="text" name="folio" maxlength="30" placeholder="Ej: 87")
          .mb-3#grupoActaFechaActa
            label.form-label.small.fw-bold(for="editActaFechaActa") Fecha del acta
              +ayuda('Día en que se firmó el acta. No puede ser futura ni anterior a la fecha de regularización.')
            input.form-control.form-control-sm#editActaFechaActa(type="date" name="fechaActa")
          .mb-3#grupoActaMotivo
            label.form-label.small.fw-bold(for="editActaMotivo") Motivo del vencimiento
