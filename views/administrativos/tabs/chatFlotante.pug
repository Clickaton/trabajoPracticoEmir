// Globo flotante para abrir el chat
button.btn.btn-primary.rounded-circle.shadow-lg#btn-chat-flotante(type="button" style="position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 1050;" onclick="toggleChat()" data-ayuda="Abrir el chat de soporte con el asistente virtual" data-bs-placement="left")
  i.bi.bi-chat-dots-fill.fs-3

// Ventana del chat (Oculta por defecto)
.card.shadow-lg#ventana-chat-flotante(style="position: fixed; bottom: 100px; right: 30px; width: 350px; display: none; z-index: 1050; border-radius: 15px; overflow: hidden;")
  .card-header.bg-primary.text-white.d-flex.justify-content-between.align-items-center
    h6.mb-0 
      i.bi.bi-robot.me-2 
      | Soporte IA
    button.btn-close.btn-close-white.btn-sm(type="button" onclick="toggleChat()" title="Cerrar el chat" aria-label="Cerrar el chat")
  
  .card-body.bg-light.p-3
    ul#chat-messages.list-unstyled(style="height: 300px; overflow-y: auto; margin-bottom: 0;")
      // Mensaje inicial de bienvenida
      li.mb-3
        .bg-white.border.border-primary.rounded.p-2.shadow-sm(style="max-width: 85%;")
          small.fw-bold.text-primary Asistente:
          br
          small ¡Hola! Soy tu asistente de soporte. Escribí tu duda y con gusto te ayudaremos.
  
  .card-footer.bg-white.p-2
    form#chat-form.d-flex
      input#chat-input.form-control.form-control-sm.me-2(type="text" placeholder="Escribí acá..." autocomplete="off" required title="Escribí tu duda y enviala")
      button.btn.btn-sm.btn-primary(type="submit" title="Enviar la consulta") 
        i.bi.bi-send-fill

//- Lógica del chat (cliente compartido con el dashboard del alumno)
include ../../partials/chat-cliente.pug
