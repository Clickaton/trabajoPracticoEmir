doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Iniciar Sesión
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet")
  body
    .container.mt-5
      .row.justify-content-center
        .col-md-6.col-lg-5
          h1.mb-4.text-center Iniciar Sesión
          
          //- Si hay error, mostramos un modal (se activa con JS)
          //- Mantener la alerta como respaldo en caso de que JS esté deshabilitado
          if error
            .alert.alert-danger.text-center(role="alert")= error

          form.card.p-4.shadow-sm(action="/login" method="POST")
            .mb-3
              label.form-label.fw-bold(for="email") Correo Electrónico:
              input.form-control(type="email" name="email" id="email" required)
            .mb-3
              label.form-label.fw-bold(for="password") Contraseña:
              input.form-control(type="password" name="password" id="password" required)
            
            //- Botón principal que ocupa todo el ancho
            button.btn.btn-primary.w-100(type="submit") Ingresar

    //- Modal de error (Bootstrap)
    if error

    //- Bootstrap JS y script para activar el modal si hay error
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
    if error
      script.
        document.addEventListener('DOMContentLoaded', function () {
          var modalEl = document.getElementById('errorModal');
          if (modalEl) {
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
          }
        });