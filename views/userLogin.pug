doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Iniciar sesión · SAT · ISFT 225
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")
    style.
      :root{
        --navy-900:#0E2245;
        --navy-800:#15304F;
        --navy-700:#1E3F73;
        --blue-400:#7FA0D6;
        --blue-300:#AFC5E8;
        --gold:#F0B429;
        --paper:#F5F7FA;
        --card:#FFFFFF;
        --text-dark:#152238;
        --text-muted:#6B7688;
        --border:#DDE2EA;
        --danger:#B3402F;
        --danger-bg:#FBEAE6;
      }
      *{box-sizing:border-box;}
      html,body{height:100%;margin:0;}
      body{
        font-family:'Inter',sans-serif;
        color:var(--text-dark);
        display:flex;
        min-height:100vh;
      }
      .panel-form{
        flex:1 1 44%;
        background:var(--paper);
        display:flex;
        align-items:center;
        justify-content:center;
        padding:48px 32px;
      }
      .form-wrap{
        width:100%;
        max-width:380px;
      }
      .eyebrow{
        font-size:12px;
        font-weight:600;
        letter-spacing:.1em;
        text-transform:uppercase;
        color:var(--navy-700);
        margin:0 0 10px;
      }
      h1.headline{
        font-family:'Poppins',sans-serif;
        font-weight:600;
        font-size:28px;
        margin:0 0 28px;
        color:var(--navy-900);
      }
      .field{margin-bottom:18px;}
      .field label{
        display:block;
        font-size:13px;
        font-weight:500;
        color:var(--text-dark);
        margin-bottom:6px;
      }
      .field input{
        width:100%;
        height:44px;
        padding:0 14px;
        border:1px solid var(--border);
        border-radius:6px;
        background:var(--card);
        font-family:'Inter',sans-serif;
        font-size:14px;
        color:var(--text-dark);
        transition:border-color .15s ease, box-shadow .15s ease;
      }
      .field input:focus{
        outline:none;
        border-color:var(--navy-700);
        box-shadow:0 0 0 3px rgba(30,63,115,.12);
      }
      .btn-primary{
        width:100%;
        height:46px;
        border:none;
        border-radius:6px;
        background:var(--navy-900);
        color:#fff;
        font-family:'Inter',sans-serif;
        font-size:14px;
        font-weight:600;
        cursor:pointer;
        margin-top:6px;
        transition:background .15s ease;
      }
      .btn-primary:hover{background:var(--navy-700);}
      .divider{
        display:flex;
        align-items:center;
        gap:12px;
        margin:22px 0;
        color:var(--text-muted);
        font-size:13px;
      }
      .divider::before,.divider::after{
        content:"";
        flex:1;
        height:1px;
        background:var(--border);
      }
      .btn-google{
        width:100%;
        height:46px;
        border:1px solid var(--border);
        border-radius:6px;
        background:var(--card);
        display:flex;
        align-items:center;
        justify-content:center;
        gap:10px;
        font-family:'Inter',sans-serif;
        font-size:14px;
        font-weight:500;
        color:var(--text-dark);
        text-decoration:none;
        transition:border-color .15s ease, background .15s ease;
      }
      .btn-google:hover{border-color:#C3CAD6;background:#FBFCFE;}
      .alert-error{
        display:flex;
        align-items:flex-start;
        gap:10px;
        background:var(--danger-bg);
        color:var(--danger);
        border-radius:6px;
        padding:12px 14px;
        font-size:13px;
        margin-bottom:20px;
      }
      .panel-brand{
        flex:1 1 56%;
        position:relative;
        background:
          radial-gradient(circle at 85% 8%, rgba(127,160,214,.28) 0%, rgba(127,160,214,0) 45%),
          linear-gradient(165deg, #16325A 0%, #102A50 45%, #0A1C38 100%);
        color:#EAF0FA;
        display:flex;
        flex-direction:column;
        justify-content:space-between;
        padding:56px 64px;
        overflow:hidden;
      }
      .panel-brand::before{
        content:"";
        position:absolute;
        inset:0;
        background-image:radial-gradient(rgba(255,255,255,.06) 1px, transparent 1px);
        background-size:24px 24px;
        pointer-events:none;
      }
      .brand-content{position:relative; z-index:1;}
      .brand-logo{
        display:flex;
        align-items:center;
        gap:12px;
        margin-bottom:64px;
      }
      .brand-logo .mark{
        width:40px;
        height:40px;
        border-radius:9px;
        background:#FFFFFF;
        display:flex;
        align-items:center;
        justify-content:center;
        font-family:'Poppins',sans-serif;
        font-weight:700;
        font-size:14px;
        color:var(--navy-900);
        flex-shrink:0;
      }
      .brand-logo .lockup-name{
        font-family:'Poppins',sans-serif;
        font-weight:600;
        font-size:15px;
        color:#FFFFFF;
        line-height:1.2;
      }
      .brand-logo .lockup-sub{
        font-size:11px;
        color:var(--blue-300);
        letter-spacing:.04em;
      }
      .brand-headline{
        font-family:'Poppins',sans-serif;
        font-weight:600;
        font-size:34px;
        line-height:1.28;
        color:#FFFFFF;
        max-width:440px;
        margin:0 0 40px;
      }
      .brand-headline .accent{color:var(--gold);}
      .feature-list{
        list-style:none;
        margin:0;
        padding:0;
        display:flex;
        flex-direction:column;
        gap:18px;
      }
      .feature-list li{
        display:flex;
        align-items:flex-start;
        gap:12px;
        font-size:14.5px;
        color:var(--blue-300);
      }
      .feature-list svg{flex-shrink:0; margin-top:2px;}
      .brand-footer{
        position:relative;
        z-index:1;
        display:flex;
        align-items:center;
        gap:10px;
        padding-top:28px;
        border-top:1px solid rgba(255,255,255,.1);
        font-size:12px;
        color:#7C8FB3;
        letter-spacing:.02em;
      }
      .brand-footer .dot{
        width:5px;
        height:5px;
        border-radius:50%;
        background:var(--gold);
        flex-shrink:0;
      }
      @media (max-width:900px){
        body{flex-direction:column;}
        .panel-brand{
          flex:0 0 auto;
          padding:32px 28px;
        }
        .brand-logo{margin-bottom:24px;}
        .brand-headline{font-size:22px;margin-bottom:24px;}
        .feature-list{display:none;}
        .brand-footer{display:none;}
        .panel-form{padding:40px 24px;}
      }
  body
    .panel-form
      .form-wrap
        p.eyebrow ISFT 225 · Acceso al sistema
        h1.headline Iniciar sesión

        if error
          .alert-error
            span= error

        form(action="/login" method="POST")
          .field
            label(for="email") Correo electrónico
            input(type="email" name="email" id="email" placeholder="nombre@isft225.edu.ar" required)
          .field
            label(for="password") Contraseña
            input(type="password" name="password" id="password" placeholder="Tu contraseña" required)

          button.btn-primary(type="submit") Ingresar

        .divider o ingresá con tu cuenta institucional

        a.btn-google(href="/auth/google")
          svg(width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg")
            path(fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.85 2.09-1.81 2.73v2.27h2.93c1.71-1.58 2.7-3.9 2.7-6.64z")
            path(fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.17l-2.93-2.27c-.81.54-1.85.86-3.03.86-2.33 0-4.3-1.57-5.01-3.68H.96v2.34C2.44 15.98 5.48 18 9 18z")
            path(fill="#FBBC05" d="M3.99 10.74A5.4 5.4 0 0 1 3.71 9c0-.6.1-1.19.28-1.74V4.92H.96A8.99 8.99 0 0 0 0 9c0 1.45.35 2.83.96 4.08l3.03-2.34z")
            path(fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.59-2.59C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.92l3.03 2.34C4.7 5.15 6.67 3.58 9 3.58z")
          | Continuar con Google

    .panel-brand
      .brand-content
        .brand-logo
          .mark SAT
          div
            .lockup-name Sistema Académico Terciario
            .lockup-sub ISFT 225

        h2.brand-headline Toda tu trayectoria académica, #[span.accent en un solo lugar.]

        ul.feature-list
          li
            svg(width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg")
              circle(cx="9" cy="9" r="9" fill="#F0B429" fill-opacity="0.15")
              path(d="M5.5 9.2l2.2 2.2 4.8-4.8" stroke="#F0B429" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")
            span Acceso único con tu cuenta institucional de Google
          li
            svg(width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg")
              circle(cx="9" cy="9" r="9" fill="#F0B429" fill-opacity="0.15")
              path(d="M5.5 9.2l2.2 2.2 4.8-4.8" stroke="#F0B429" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")
            span Consultar información académica
          li
            svg(width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg")
              circle(cx="9" cy="9" r="9" fill="#F0B429" fill-opacity="0.15")
              path(d="M5.5 9.2l2.2 2.2 4.8-4.8" stroke="#F0B429" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")
            span Gestionar la información institucional
          li
            svg(width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg")
              circle(cx="9" cy="9" r="9" fill="#F0B429" fill-opacity="0.15")
              path(d="M5.5 9.2l2.2 2.2 4.8-4.8" stroke="#F0B429" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")
            span Toda la trayectoria del alumno, desde el ingreso hasta el egreso

      .brand-footer
        .dot
        span Desarrollado por Brian Alcaraz y Christian Antognazza (PATENTE PENDIENTE)

    if error
      script.
        document.addEventListener('DOMContentLoaded', function () {
          var input = document.getElementById('email');
          if (input) input.focus();
        });