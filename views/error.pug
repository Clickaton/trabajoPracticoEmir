doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title + ' · ISFT 225'
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet")
    style.
      :root{--navy:#0e2245;--blue:#1e3f73;--gold:#f0b429;--paper:#f5f7fa;--muted:#68758a;}
      *{box-sizing:border-box;}
      body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:radial-gradient(circle at 15% 10%, #dce8f8 0, transparent 34%), var(--paper);color:var(--navy);font-family:'Inter',sans-serif;}
      main{width:min(100%,560px);text-align:center;background:#fff;border:1px solid #dde2ea;border-radius:8px;padding:56px 36px;box-shadow:0 18px 45px rgba(14,34,69,.1);}
      .code{margin:0;color:var(--gold);font-family:'Poppins',sans-serif;font-size:18px;font-weight:700;letter-spacing:.08em;}
      h1{margin:12px 0 14px;font-family:'Poppins',sans-serif;font-size:clamp(26px,5vw,38px);line-height:1.15;}
      p{margin:0 auto 30px;max-width:410px;color:var(--muted);line-height:1.6;}
      a{display:inline-block;padding:12px 22px;border-radius:6px;background:var(--navy);color:#fff;text-decoration:none;font-weight:600;}
      a:hover{background:var(--blue);}
  body
    main
      p.code= statusCode
      h1= title
      p= message
      a(href="/login") Volver al inicio de sesión